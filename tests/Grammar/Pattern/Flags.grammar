lexer: "Pattern.lexer";

context: "\pharos\phathom\tests\Grammar\File";

ICASE:   </[a-z]/i>;
NUMERIC: </\d+/>;

first: (ALPHA EQUALS NUMERIC) {
    return $this->returnThings($1, $3);
};

second: (NUMERIC EQUALS NUMERIC) {
    return $this->returnThings((int) $1, (int) $3);
};

third: (ALPHA EQUALS ICASE+) {
    return $this->returnThings($1, (array) $3);
};

line: first  |
      second |
      third;

unit: line+;