lexer: "Pattern.lexer";

ICASE:   </[a-z]/i>;
NUMERIC: </\d+/>;

first: (ALPHA EQUALS NUMERIC) {
    return [(string) $1 => (string) $3];
};

second: (NUMERIC EQUALS NUMERIC) {
    return [(int) (string) $1 => (int) (string) $3];
};

third: (ALPHA EQUALS ICASE+) {
    return [(string) $1 => array_map('strval', $3)];
};

line: first  |
      second |
      third;

unit: line+;