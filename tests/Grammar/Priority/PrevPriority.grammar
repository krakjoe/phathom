lexer: "PriorityPropagation.lexer";

type: "\pharos\phathom\tests\Grammar\File";

# a completes with priority 3, which flows into b's intermediate item.
# When collectValues walks b's token-back for the trailing X, the prev
# item (b@dot=1) carries a non-false priority -- exercising the prev
# branch of selectPriority that returns a real priority value.
a: (X) [3] { return $1; };

b: (a X) [1] { return $this->returnThings(1, $1); }
 | (a X) [4] { return $this->returnThings(4, $1); }
 ;

unit: b;
