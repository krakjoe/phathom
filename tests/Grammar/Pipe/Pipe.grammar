lexer: "Pipe.lexer";

context: "\pharos\phathom\tests\Grammar\Pipe\File";

section:
    (LEFT_BRACKET ALPHA RIGHT_BRACKET) {
        return $this->section((string) $2);
    };

item:
    (ALPHA EQUALS ALPHA) {
        return $this->item((string) $1, (string) $3);
    };

line: section | item;

unit: (line*) { return $this->things; };