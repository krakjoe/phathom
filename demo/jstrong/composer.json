{
    "name": "phathom/jstrong",
    "description": "Typed JSON with self-references — phathom grammar demo",
    "autoload": {
        "psr-4": {
            "pharos\\phathom\\": "../../src/phathom/",
            "pharos\\phathom\\demo\\jstrong\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "pharos\\phathom\\demo\\jstrong\\tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": false
}
