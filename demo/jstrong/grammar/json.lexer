[WHITESPACE]
pattern = "/\s+/"
skip    = true

[COMMENT]
pattern = "/\/\*.*?\*\//"
skip    = true

[STRING]
pattern = "/\"(?:[^\"\\\\]|\\\\.)*\"/"

[FLOAT]
pattern = "/\-?(?:0|[1-9][0-9]*)(?:\.[0-9]+)(?:[eE][+-]?[0-9]+)?/"

[INTEGER]
pattern = "/\-?(?:0|[1-9][0-9]*)(?:[eE][+-]?[0-9]+)?/"

[LBRACE]
pattern = "/\{/"

[RBRACE]
pattern = "/\}/"

[LBRACKET]
pattern = "/\[/"

[RBRACKET]
pattern = "/\]/"

[COLON]
pattern = "/\:/"

[COMMA]
pattern = "/,/"
